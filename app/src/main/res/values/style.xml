<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ========================= -->
    <!-- ESTILO DE TARJETAS (Modern SaaS) -->
    <!-- ========================= -->

    <style name="DashboardCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="strokeColor">@color/grayBorder</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="CardConEsquinasSuperiores" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/grayBorder</item>
        <item name="strokeWidth">1dp</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.App.Card.TopRounded</item>
    </style>

    <style name="ShapeAppearance.App.Card.TopRounded" parent="">
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ========================= -->
    <!-- INPUTS Y CAMPOS DE TEXTO -->
    <!-- ========================= -->

    <style name="LoginTextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/grayBorder</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxCornerRadiusTopStart">12dp</item>
        <item name="boxCornerRadiusTopEnd">12dp</item>
        <item name="boxCornerRadiusBottomStart">12dp</item>
        <item name="boxCornerRadiusBottomEnd">12dp</item>
        <item name="hintTextColor">@color/textSecondary</item>
    </style>

    <style name="InvenzoInput">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">14dp</item>
        <item name="android:textColor">@color/textPrimary</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="InvenzoLabel">
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/primaryColor</item>
    </style>

    <!-- ========================= -->
    <!-- BOTONES -->
    <!-- ========================= -->

    <style name="InvenzoButton" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/primaryColor</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- ========================= -->
    <!-- NAVEGACIÓN Y OTROS -->
    <!-- ========================= -->

    <style name="Divider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">@color/grayBorder</item>
    </style>

    <!-- Estilo para imágenes circulares (usado en múltiples layouts) -->
    <style name="CircleImage">
        <item name="cornerSize">50%</item>
    </style>

    <!-- Alias para compatibilidad con layouts que usan minúsculas -->
    <style name="circleImage" parent="CircleImage" />

</resources>
