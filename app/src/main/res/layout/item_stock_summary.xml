<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <!-- Indicador visual circular (Icono de Producto/Caja) -->
    <FrameLayout
        android:id="@+id/productIconContainer"
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_circle_light_blue"
        android:backgroundTint="@color/blueVeryLight"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_inventory"
            app:tint="@color/primaryColor"
            android:contentDescription="@string/inventory_control_title" />
    </FrameLayout>

    <!-- Info del Producto y Categoría -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/stockDataContainer"
        app:layout_constraintStart_toEndOf="@id/productIconContainer"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txtStockProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/sample_product_name"
            android:textColor="@color/textPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStockCategoria"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Categoría: General"
            android:textColor="@color/textSecondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Cantidad de Stock y Badge de Estado -->
    <LinearLayout
        android:id="@+id/stockDataContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/txtStockActual"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stock: 0"
            android:textColor="@color/textPrimary"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_green_icon"
            android:backgroundTint="@color/successLight"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:text="@string/available"
            android:textColor="@color/successColor"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Divisor elegante alineado con el texto -->
    <View
        android:layout_width="0dp"
        android:layout_height="1dp"
        android:background="#F1F5F9"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/productIconContainer" />

</androidx.constraintlayout.widget.ConstraintLayout>